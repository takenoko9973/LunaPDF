{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "command": "cargo",
            "args": [
                "run"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "label": "rust: run linux"
        },
        {
            "type": "shell",
            "command": "cargo",
            "args": [
                "--release"
            ],
            "problemMatcher": [
                "run",
                "$rustc"
            ],
            "label": "rust: run linux release"
        },
        {
            "type": "shell",
            "command": "sh",
            "args": [
                "-c",
                "cargo build --target=x86_64-pc-windows-gnu && install -D target/x86_64-pc-windows-gnu/debug/lunapdf.exe /workspace/dist/lunapdf-debug.exe"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "label": "rust: cross compile for windows"
        },
        {
            "type": "shell",
            "command": "sh",
            "args": [
                "-c",
                "cargo build --release --target=x86_64-pc-windows-gnu && install -D target/x86_64-pc-windows-gnu/release/lunapdf.exe /workspace/dist/lunapdf-release.exe"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "label": "rust: cross compile for windows release"
        },
        {
            "type": "shell",
            "command": "install-update",
            "problemMatcher": [
                "$rustc"
            ],
            "args": [
                "-a",
            ],
            "group": {
                "kind": "none",
                "isDefault": false
            },
            "label": "rust: update all cargo installed package"
        }
    ]
}
